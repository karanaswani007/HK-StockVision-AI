# Local-only settings. Production deployments should use the host's secret manager.
# Do not put real credentials in this file or commit a copied .env.

# Optional PostgreSQL connection string. Leave unset when using the local database.
DATABASE_URL=

# Optional server-side Gemini API key. Keep it private; never use a VITE_ prefix.
GEMINI_API_KEY=

# Optional Better Auth configuration for self-managed deployments.
# The managed preview/deployment platform provides its own auth configuration.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
